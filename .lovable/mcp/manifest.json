{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://intukcahfsrisodjjvcy.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bdea-mcp",
      "version": "0.1.0",
      "title": "BDEA — Border Digital Evidence Assistant"
    },
    "tools": [
      {
        "name": "list_incidents",
        "title": "List incidents",
        "description": "List every chain-of-custody incident record saved by the signed-in BDEA user, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_incident",
        "title": "Get incident",
        "description": "Fetch a single incident record by its BDEA evidence ID (format BDEA-YYYYMMDD-HHMMSS-XXXX).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1,
              "description": "Evidence ID, e.g. BDEA-20260726-093015-4821"
            }
          },
          "required": [
            "evidence_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_incident",
        "title": "Create incident",
        "description": "Create a new chain-of-custody incident record for the signed-in BDEA user. If evidence_id is omitted, one is generated (BDEA-YYYYMMDD-HHMMSS-XXXX).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "description": "Optional evidence ID. Generated if omitted."
            },
            "case_number": {
              "type": "string"
            },
            "date_time": {
              "type": "string",
              "description": "ISO local datetime (YYYY-MM-DDTHH:mm)."
            },
            "location": {
              "type": "string",
              "description": "Location or coordinates."
            },
            "border_point": {
              "type": "string"
            },
            "officer_name": {
              "type": "string"
            },
            "badge_id": {
              "type": "string"
            },
            "agency": {
              "type": "string",
              "description": "hellenic | frontex | other"
            },
            "witness_name": {
              "type": "string"
            },
            "witness_id": {
              "type": "string"
            },
            "device_type": {
              "type": "string",
              "description": "smartphone | laptop | tablet | usb | sim | hdd | drone | other"
            },
            "make": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "serial": {
              "type": "string"
            },
            "imei": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "power": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "unknown"
              ]
            },
            "screen_locked": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "encryption": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "network": {
              "type": "string"
            },
            "circumstances": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_incident",
        "title": "Delete incident",
        "description": "Permanently delete an incident record owned by the signed-in BDEA user, by evidence ID.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "evidence_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "evidence_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "decision_support",
        "title": "Decision support triage",
        "description": "Run BDEA's ISO/IEC 27037 + ACPO triage. Given device state answers, returns the recommended actions and cited principles for handling a seized device at an EU external border.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "device_type": {
              "type": "string",
              "enum": [
                "smartphone",
                "laptop",
                "tablet",
                "usb",
                "sim",
                "hdd",
                "drone",
                "other"
              ]
            },
            "powered_on": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "encryption": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "witness_present": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "time_pressure": {
              "type": "string",
              "enum": [
                "immediate",
                "standard"
              ]
            }
          },
          "required": [
            "device_type",
            "powered_on",
            "encryption",
            "witness_present",
            "time_pressure"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "lookup_handbook",
        "title": "BDEA handbook lookup",
        "description": "Return a section of the BDEA reference handbook: ISO/IEC 27037 overview, ACPO principles, device-specific quick guides, or the glossary.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "enum": [
                "iso_27037",
                "acpo_principles",
                "devices",
                "glossary"
              ]
            }
          },
          "required": [
            "section"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
